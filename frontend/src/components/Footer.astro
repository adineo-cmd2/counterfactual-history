---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/start", "label": "Start"}, {"href": "/timeline", "label": "Timeline"}, {"href": "/branch-explorer", "label": "Branches"}, {"href": "/compare", "label": "Compare"}, {"href": "/library", "label": "Library"}];
---
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a href={base || '/'} class="brand" style="margin-bottom: 0.9rem">
        <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="4" r="2.5"/><circle cx="6" cy="20" r="2.5"/><circle cx="18" cy="12" r="2.5"/><path d="M6 6.5v11M8.5 5.8c4 1 5.7 3.4 7 5.9"/></svg></span>
        <span>WhatIf Atlas</span>
      </a>
      <p class="text-sm leading-relaxed" style="color: var(--ink-soft); max-width: 34rem">
        All simulated events are speculative fiction, not history. Probability legend — high: strong precedent · medium: plausible · speculative: thin evidence.
      </p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Project</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/counterfactual-history" target="_blank" rel="noreferrer">Source on GitHub ↗</a></li>
        <li><a href="https://adineo-cmd2.github.io/counterfactual-history/" target="_blank" rel="noreferrer">Live site ↗</a></li>
        <li><span style="font-size: 0.88rem">Local backend · <span class="mono">localhost:8006</span></span></li>
        <li><span style="font-size: 0.88rem">FastAPI + Astro + React</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} WhatIf Atlas · Aditya Yadav</span>
      <span>Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>
