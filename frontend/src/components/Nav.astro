---
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/start", "label": "Start"}, {"href": "/timeline", "label": "Timeline"}, {"href": "/branch-explorer", "label": "Branches"}, {"href": "/compare", "label": "Compare"}, {"href": "/library", "label": "Library"}];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand">
      <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="4" r="2.5"/><circle cx="6" cy="20" r="2.5"/><circle cx="18" cy="12" r="2.5"/><path d="M6 6.5v11M8.5 5.8c4 1 5.7 3.4 7 5.9"/></svg></span>
      <span>WhatIf Atlas</span>
    </a>
    <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href === '/' ? base || '/' : `${base}${l.href}`}
              data-navlink={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li class="hidden md:ml-2 md:inline-flex">
          <a href={`${base}/start`} class="nav-link nav-cta">Start a simulation</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
